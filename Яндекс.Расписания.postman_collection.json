    {
      "name": "4. Ближайшие станции",
      "item": [
        {
          "name": "Позитивный: Курчатов (50 км)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Статус-код 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"В ответе есть массив stations\", function () {",
                  "    const j = pm.response.json();",
                  "    pm.expect(j.stations).to.be.an(\"array\");",
                  "});",
                  "pm.test(\"Каждая станция имеет distance и code\", function () {",
                  "    const stations = pm.response.json().stations;",
                  "    stations.forEach(function(s) {",
                  "        pm.expect(s.distance).to.be.a(\"number\");",
                  "        pm.expect(s.code).to.be.a(\"string\");",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/nearest_stations?apikey={{api_key}}&lat=51.67&lng=35.65&distance=50&format=json&lang=ru_RU&limit=10",
